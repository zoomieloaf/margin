{
  "name": "margin",
  "displayName": "Margin",
  "description": "Notion-style Markdown editing for VS Code and Cursor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures:make": "node scripts/make-fixtures.mjs",
    "fixtures:fetch": "node scripts/fetch-corpus.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
