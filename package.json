{
  "name": "margin",
  "displayName": "Margin — Markdown Editor",
  "description": "Notion-style Markdown editing for VS Code and Cursor: preview, edit in place, selection menu, slash commands, export to PDF. Your file stays plain Markdown.",
  "version": "0.1.0",
  "publisher": "zoomieloaf",
  "license": "MIT",
  "private": true,
  "type": "module",
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "preview",
    "docs",
    "documentation",
    "knowledge base",
    "writing",
    "pdf",
    "export"
  ],
  "engines": {
    "node": ">=20",
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "margin.editor",
        "displayName": "Margin",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "margin.openInMargin",
        "title": "Open in Margin",
        "category": "Margin",
        "icon": "$(book)"
      },
      {
        "command": "margin.reopenAsText",
        "title": "Reopen in Text Editor",
        "category": "Margin",
        "icon": "$(go-to-file)"
      },
      {
        "command": "margin.toggleMode",
        "title": "Toggle Preview / Edit",
        "category": "Margin"
      },
      {
        "command": "margin.changePageWidth",
        "title": "Change Page Width",
        "category": "Margin"
      },
      {
        "command": "margin.exportPdf",
        "title": "Export to PDF",
        "category": "Margin"
      },
      {
        "command": "margin.exportHtml",
        "title": "Export to HTML",
        "category": "Margin"
      },
      {
        "command": "margin.copyMarkdown",
        "title": "Copy as Markdown",
        "category": "Margin"
      },
      {
        "command": "margin.undo",
        "title": "Undo (Margin editor)",
        "category": "Margin"
      },
      {
        "command": "margin.redo",
        "title": "Redo (Margin editor)",
        "category": "Margin"
      },
      {
        "command": "margin.webviewKey",
        "title": "Shortcut handled by the Margin editor",
        "category": "Margin"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "margin.openInMargin",
          "when": "resourceLangId == markdown && activeCustomEditorId != 'margin.editor'",
          "group": "navigation"
        },
        {
          "command": "margin.reopenAsText",
          "when": "activeCustomEditorId == 'margin.editor'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "margin.reopenAsText",
          "when": "activeCustomEditorId == 'margin.editor'"
        },
        {
          "command": "margin.toggleMode",
          "when": "activeCustomEditorId == 'margin.editor'"
        },
        {
          "command": "margin.changePageWidth",
          "when": "activeCustomEditorId == 'margin.editor'"
        },
        {
          "command": "margin.undo",
          "when": "false"
        },
        {
          "command": "margin.redo",
          "when": "false"
        },
        {
          "command": "margin.webviewKey",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Margin",
      "properties": {
        "margin.defaultMode": {
          "type": "string",
          "enum": [
            "preview",
            "edit"
          ],
          "default": "preview",
          "description": "Mode used when a Markdown file opens in Margin."
        },
        "margin.exportFolder": {
          "type": "string",
          "default": "",
          "description": "Folder for exported PDF and HTML files, relative to the workspace. Empty means next to the Markdown file."
        },
        "margin.export.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "default": "light",
          "description": "Color theme of exported PDF and HTML files. 'auto' follows the current VS Code theme."
        },
        "margin.export.browserPath": {
          "type": "string",
          "default": "",
          "description": "Path to Chrome, Edge or Chromium used for PDF export. Empty means detect automatically."
        },
        "margin.ai": {
          "type": "string",
          "enum": [
            "auto",
            "editor",
            "chatgpt",
            "claude",
            "off"
          ],
          "enumDescriptions": [
            "The editor's AI model (GitHub Copilot in VS Code) when there is one; otherwise the prompt is copied and a chat opens: the editor's own chat (Copilot Chat in VS Code, a new chat in Cursor), or chatgpt.com when the editor has none.",
            "Only the editor's AI model (GitHub Copilot in VS Code). Results appear as a suggestion you accept or discard.",
            "Copy the prompt and open chatgpt.com. Paste the answer back with Ctrl+V.",
            "Copy the prompt and open claude.ai. Paste the answer back with Ctrl+V.",
            "Hide all AI actions."
          ],
          "default": "auto",
          "markdownDescription": "Where AI actions (Improve writing, Translate, Continue writing...) send the selected text. Text is sent only when you run an AI action."
        },
        "margin.outline.visible": {
          "type": "boolean",
          "default": true,
          "description": "Show the outline panel when there is room."
        },
        "margin.pageWidth": {
          "type": "string",
          "enum": [
            "narrow",
            "normal",
            "wide",
            "full"
          ],
          "enumDescriptions": [
            "A 600 px text column.",
            "A 716 px text column.",
            "A 1000 px text column.",
            "The whole editor width, with side padding."
          ],
          "default": "normal",
          "markdownDescription": "Width of the text column in Margin. Each file can have its own width (the width button in the toolbar, or **Margin: Change Page Width**). Exported PDF and HTML files keep their own print width."
        },
        "margin.links.openIn": {
          "type": "string",
          "enum": [
            "sameTab",
            "newTab"
          ],
          "enumDescriptions": [
            "Linked pages open in the preview tab, which the next page replaces (follows workbench.editor.enablePreview)",
            "Every linked page opens in its own tab"
          ],
          "default": "sameTab",
          "markdownDescription": "Where a link clicked in Margin opens its page. Ctrl+click (Cmd+click on macOS) does the opposite."
        }
      }
    },
    "keybindings": [
      {
        "command": "margin.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused"
      },
      {
        "command": "margin.redo",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused"
      },
      {
        "command": "margin.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused"
      },
      {
        "command": "margin.webviewKey",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused && margin.editing"
      },
      {
        "command": "margin.webviewKey",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused && margin.editing"
      },
      {
        "command": "margin.webviewKey",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused"
      },
      {
        "command": "margin.webviewKey",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused && margin.editing"
      },
      {
        "command": "margin.webviewKey",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused && margin.editing"
      },
      {
        "command": "margin.webviewKey",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused && margin.editing"
      },
      {
        "command": "margin.webviewKey",
        "key": "alt+left",
        "mac": "ctrl+-",
        "linux": "ctrl+alt+-",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused"
      },
      {
        "command": "margin.webviewKey",
        "key": "ctrl+`",
        "mac": "cmd+`",
        "when": "activeCustomEditorId == 'margin.editor' && margin.webviewFocused && margin.editing"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && node test/integration/run.mjs",
    "e2e": "npm run build && node test/e2e/webview.e2e.mjs",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/icon.mjs",
    "package": "npm run build:prod && vsce package --no-dependencies",
    "publish:vscode": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "fixtures:make": "node scripts/make-fixtures.mjs",
    "fixtures:fetch": "node scripts/fetch-corpus.mjs"
  },
  "dependencies": {
    "hast-util-to-html": "9.0.5",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/jsdom": "21.1.7",
    "@types/mdast": "4.0.4",
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.24.2",
    "jsdom": "25.0.1",
    "ovsx": "0.10.12",
    "puppeteer-core": "23.11.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
